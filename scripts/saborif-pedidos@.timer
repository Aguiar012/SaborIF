[Unit]
Description=Pedidos SaborIF %i as 06h e 13h de Brasilia

[Timer]
OnCalendar=Mon..Fri *-*-* 06:00:00 America/Sao_Paulo
OnCalendar=Mon..Fri *-*-* 13:00:00 America/Sao_Paulo
AccuracySec=1s
RandomizedDelaySec=0
# Reiniciar a VM depois do prazo nao pode disparar pedidos atrasados.
Persistent=false

[Install]
WantedBy=timers.target
